# Copy to .env and fill in. Provider config is read at runtime; the app works
# without any of it (deterministic planner/reviewer + template prose), but
# reasoning text gets richer with a provider configured.

# Preferred: Amazon Bedrock. Two auth options (pick one):
#   (a) A long-term bearer token for Bedrock (single value):
AWS_BEARER_TOKEN_BEDROCK=
#   (b) Standard AWS IAM credentials (access key + secret key):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# Fallbacks (used only if Bedrock is not configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional overrides
# VENDOR_DB_PATH=/absolute/path/to/vendor_onboarding.db
# VECTOR_STORE_PATH=/absolute/path/to/chroma
